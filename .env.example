# Bu dosyayı KOPYALAYIP ".env" adıyla kaydedin ve değerleri doldurun.
# .env dosyası git'e GİTMEZ (gizli bilgiler içerir).

# Yeni anahtar üretmek için:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=buraya-uretilen-anahtari-yapistirin

# Yerelde geliştirme yaparken 1, canlıda 0 olmali.
DJANGO_DEBUG=1

# Canlida kendi adresinizle doldurun (yerelde bos kalabilir).
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL (sadece canlı/PythonAnywhere için doldurulur; yerelde boş bırakın) ---
# Bu değerler PythonAnywhere > Databases > Postgres sayfasından alınır.
# DB_NAME boş bırakılırsa sistem otomatik SQLite kullanır.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_SSLMODE=
